# Copy to .env. Everything here can also be set from the dashboard's
# Connections page, which writes this file for you.

# ---- AI engine -----------------------------------------------------------
# "claude_cli" (default) runs Claude Code on your Claude subscription.
# "anthropic_api" uses an Anthropic API key instead (pay per use).
JOBHUNT_LLM_BACKEND=claude_cli
# Found automatically if blank. Set it if Claude Code lives somewhere unusual.
CLAUDE_CLI_PATH=
# Only needed when JOBHUNT_LLM_BACKEND=anthropic_api
ANTHROPIC_API_KEY=

# ---- Where your data lives ----------------------------------------------
# Database, profile, resumes, browser session and logs. Relative paths are
# resolved against this folder. Default: data
JOBHUNT_DATA_DIR=data

# ---- Gmail (optional) ----------------------------------------------------
# Blank = <data>/profile/client_secret.json, which the Connections page writes.
GOOGLE_OAUTH_CLIENT_SECRET_FILE=

# ---- Google Programmable Search (optional, free 100 queries/day) -------
# Improves recruiter discovery. Without it, that step uses DuckDuckGo.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
